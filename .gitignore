# dependencies
node_modules/
.pnp/

# runtime data
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# env & secrets
.env
.env.local
.env.*.local

# build output
#
# apps/server/dist IS tracked on purpose: `npm install github:...` installs from
# the repo, and shipping the prebuilt bundle + static UI is what keeps that path
# from compiling Next.js on the user's machine. Everything below is intermediate.
apps/web/.next/
apps/web/out/
*.tsbuildinfo
*.tgz
# tsc dumps if someone runs `tsc -p apps/server`. Only cli.js, index.js, and
# public/ are the shipped artifacts from esbuild + the Next export.
apps/server/dist/*.d.ts
apps/server/dist/*.map
apps/server/dist/app.js
apps/server/dist/config.js
apps/server/dist/db/
apps/server/dist/engine/
apps/server/dist/lib/
apps/server/dist/providers/
apps/server/dist/routes/
apps/server/dist/vault/
apps/server/dist/types/

# testing / coverage
coverage/

# editors & OS
.DS_Store
.idea/
.vscode/
*.swp

# logs
logs/
*.log
