# OpenCouncil server configuration
# Copy to .env and adjust. All values optional except where noted.

# HTTP bind
HOST=127.0.0.1
PORT=4311

# SQLite database file location (relative to apps/server or absolute)
DATABASE_PATH=./data/opencouncil.db

# Master key for encrypting provider API keys at rest (AES-256-GCM).
# REQUIRED for production. If unset, a random ephemeral key is generated per
# boot and previously stored provider keys become unreadable after restart.
OPEN_COUNCIL_SECRET_KEY=

# Seed a demo council (mock providers) on first boot so you can try the
# chamber without any real keys. Set to false for a clean instance.
SEED_DEMO_COUNCIL=true

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
