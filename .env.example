# OpenCouncil server configuration
#
# Copy to .env — it is read from the working directory at startup. A real
# environment variable overrides anything set here, and a CLI flag overrides
# both. Set OPEN_COUNCIL_ENV_FILE to read a different file.
#
# Values are optional. Never commit a filled-in environment file.

# HTTP bind. Use 0.0.0.0 only behind an authenticating reverse proxy —
# configure the operator token and allowed hosts below. Flags: --host / --port
HOST=127.0.0.1
PORT=4311

# Optional single-operator authentication. Use at least 32 characters. Browser
# sessions use a 12-hour HttpOnly SameSite=Strict cookie; headless clients may
# send Authorization: Bearer <token>. Generate with: openssl rand -hex 32
# OPEN_COUNCIL_OPERATOR_TOKEN=
# Comma-separated hostnames, without ports. Defaults to localhost/loopback and
# a concrete HOST value. Required for custom domains and prevents Host spoofing.
# OPEN_COUNCIL_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Enable Secure on the session cookie when the public origin uses HTTPS.
OPEN_COUNCIL_SECURE_COOKIES=false
# Optional server-wide upper limit; a request may choose a smaller budget.
# Calls with unknown model pricing fail closed when any USD limit applies.
# OPEN_COUNCIL_MAX_SESSION_USD=5

# SQLite database file, relative to the working directory. Flag: --db
DATABASE_PATH=./data/opencouncil.db

# Master key for encrypting provider API keys at rest (AES-256-GCM).
# If unset, a random key is stored in .secret_key beside the database (mode 0600).
# Back up that file, or set an explicit stable key for managed deployments.
# If writing the key fails, startup warns and the key is ephemeral.
# Generate one with: openssl rand -hex 32
# Back this up alongside the database — neither is useful without the other.
OPEN_COUNCIL_SECRET_KEY=

# Seed a demo council (mock provider) on first boot so you can try the
# chamber without any real keys. Set to false for a clean instance.
SEED_DEMO_COUNCIL=true

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Set false to prevent session topics from being sent to search providers,
# including sessions created through the CLI. Model requests still run.
WEB_RESEARCH_ENABLED=true

# Optional web-search backends. If none are set, OpenCouncil uses DuckDuckGo
# then Wikipedia so research still runs with zero config.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=
