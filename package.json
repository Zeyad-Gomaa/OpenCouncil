{
  "name": "opencouncil",
  "version": "0.3.0",
  "description": "Self-hosted BYOK platform where multiple LLMs convene as a council to research, deliberate, and agree.",
  "license": "MIT",
  "author": "Zeyad Gomaa",
  "homepage": "https://github.com/Zeyad-Gomaa/OpenCouncil",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zeyad-Gomaa/OpenCouncil.git"
  },
  "keywords": [
    "llm",
    "ai",
    "multi-agent",
    "council",
    "byok",
    "deliberation",
    "openai",
    "anthropic",
    "gemini"
  ],
  "bin": {
    "opencouncil": "./bin/opencouncil.js"
  },
  "files": [
    "bin/",
    "apps/server/dist/",
    "apps/server/package.json",
    "docs/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "build:shared": "tsc -p packages/shared",
    "build:server": "esbuild apps/server/src/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external '--alias:@opencouncil/shared=./packages/shared/dist/index.js' --outfile=apps/server/dist/cli.js && esbuild apps/server/src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external '--alias:@opencouncil/shared=./packages/shared/dist/index.js' --outfile=apps/server/dist/index.js",
    "build:web": "next build apps/web && node scripts/copy-web.js",
    "dev": "npm run build:shared && npm run build:server && concurrently -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch apps/server/dist/index.js",
    "dev:web": "next dev -p 3000 apps/web",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node apps/server/dist/cli.js",
    "serve:api": "node apps/server/dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "next": "^14.2.15",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8"
  }
}
